## 🔐 RLS 策略

```sql
-- 學員可讀寫自己的評估
CREATE POLICY "Clients can manage own assessments"
  ON health_assessments FOR ALL
  USING (auth.uid() = client_id);

-- 教練可讀學員的評估（透過關係）
CREATE POLICY "Coaches can view client assessments"
  ON health_assessments FOR SELECT
  USING (
    EXISTS (
      SELECT 1 FROM coaching_relationships
      WHERE coach_id = auth.uid()
        AND client_id = health_assessments.client_id
        AND status = 'active'
    )
  );
```

